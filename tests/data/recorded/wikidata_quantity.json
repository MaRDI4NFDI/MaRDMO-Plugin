  "body": "{\n  \"head\" : {\n    \"vars\" : [ \"id\", \"qid\", \"is_stochastic\", \"is_dimensionless\", \"is_mathematical_constant\", \"is_physical_constant\", \"class\", \"qudt_quantitykind_id\", \"aliases\", \"publication\" ]\n  },\n  \"results\" : {\n    \"bindings\" : [ {\n      \"id\" : {\n        \"type\" : \"uri\",\n        \"value\" : \"http://www.wikidata.org/entity/Q3686031\"\n      },\n      \"is_stochastic\" : {\n        \"type\" : \"literal\",\n        \"value\" : \"False\"\n      },\n      \"is_dimensionless\" : {\n        \"type\" : \"literal\",\n        \"value\" : \"False\"\n      },\n      \"is_mathematical_constant\" : {\n        \"type\" : \"literal\",\n        \"value\" : \"False\"\n      },\n      \"is_physical_constant\" : {\n        \"type\" : \"literal\",\n        \"value\" : \"False\"\n      },\n      \"qudt_quantitykind_id\" : {\n        \"type\" : \"literal\",\n        \"value\" : \"Concentration\"\n      },\n      \"qid\" : {\n        \"type\" : \"literal\",\n        \"value\" : \"wikidata:Q3686031\"\n      },\n      \"aliases\" : {\n        \"type\" : \"literal\",\n        \"value\" : \"concentration (chemical properties) <|> chemical concentrations <|> chemical concentration\"\n      }\n    } ]\n  }\n}",
  "request": {
   "method": "POST",
   "params": {},
   "data": "SELECT\n?id\n(REPLACE(STR(?id), \"http://www.wikidata.org/entity/\", \"wikidata:\") AS ?qid)\n?is_stochastic ?is_dimensionless\n?is_mathematical_constant ?is_physical_constant\n?class ?qudt_quantitykind_id\n(GROUP_CONCAT(DISTINCT ?alias; SEPARATOR=\" <|> \") AS ?aliases)\n(GROUP_CONCAT(DISTINCT CONCAT(?pub, \" || \", ?publ, \" || \", ?pubd); SEPARATOR=\" <|> \") AS ?publication)\n\nWHERE {\n\n    VALUES ?id {wd:Q3686031}\n\n    # Many Wikidata quantities are no instance of either class; their class\n    # stays empty and is chosen by the user\n    OPTIONAL {\n        {\n            ?id wdt:P31 wd:Q309314.\n            BIND(\"Quantity\" AS ?class)\n        }\n        UNION\n        {\n            ?id wdt:P31 wd:Q110653654.\n            BIND(\"QuantityKind\" AS ?class)\n        }\n    }\n\n    OPTIONAL { ?id wdt:P31 wd:Q108920450. BIND(\"True\" AS ?is_stochastic_raw) }\n    BIND(COALESCE(?is_stochastic_raw, \"False\") AS ?is_stochastic)\n\n    OPTIONAL { ?id wdt:P31 wd:Q126818. BIND(\"True\" AS ?is_dimensionless_raw) }\n    BIND(COALESCE(?is_dimensionless_raw, \"False\") AS ?is_dimensionless)\n\n    OPTIONAL { ?id wdt:P31 wd:Q186509. BIND(\"True\" AS ?is_mathematical_constant_raw) }\n    BIND(COALESCE(?is_mathematical_constant_raw, \"False\") AS ?is_mathematical_constant)\n\n    OPTIONAL { ?id wdt:P31 wd:Q173227. BIND(\"True\" AS ?is_physical_constant_raw) }\n    BIND(COALESCE(?is_physical_constant_raw, \"False\") AS ?is_physical_constant)\n\n    OPTIONAL {\n        ?id wdt:P8393 ?qudt_quantitykind_id\n    }\n\n    OPTIONAL {\n        ?id skos:altLabel ?alias .\n        FILTER (LANG(?alias) = \"en\")\n    }\n\n    OPTIONAL {\n        ?id p:P1343 ?statement_p .\n        ?statement_p ps:P1343 ?pubraw .\n        ?statement_p pq:P3831 ?role .\n        VALUES ?role { wd:Q788790 wd:Q12579633 wd:Q265158 wd:Q1298668 wd:Q1724915 }\n        BIND(REPLACE(STR(?pubraw), \"http://www.wikidata.org/entity/\", \"wikidata:\") AS ?pub)\n\n        OPTIONAL {\n            ?pubraw rdfs:label ?publraw.\n            FILTER (lang(?publraw) = 'en')\n        }\n        BIND(COALESCE(?publraw, \"No Label Provided!\") AS ?publ)\n\n        OPTIONAL {\n            ?pubraw schema:description ?pubdraw\n            FILTER (lang(?pubdraw) = 'en')\n        }\n        BIND(COALESCE(?pubdraw, \"No Description Provided!\") AS ?pubd)\n    }\n}\nGROUP BY ?id ?is_stochastic ?is_dimensionless ?is_mathematical_constant ?is_physical_constant\n         ?class ?qudt_quantitykind_id",
