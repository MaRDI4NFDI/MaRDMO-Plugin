# Part 2 of 9 of the MaRDI query model-basics_mardi.sparql (see README.md).
SELECT
?id
?is_linear
?is_not_linear
?is_dynamic
?is_static

WHERE {{

    VALUES ?id {{{0}}}

    OPTIONAL {{ ?id wdt:{instance of} wd:{linear model}. BIND("True" AS ?is_linear_raw) }}

    BIND(COALESCE(?is_linear_raw, "False") AS ?is_linear)

    OPTIONAL {{ ?id wdt:{instance of} wd:{nonlinear model}. BIND("True" AS ?is_not_linear_raw) }}

    BIND(COALESCE(?is_not_linear_raw, "False") AS ?is_not_linear)

    OPTIONAL {{ ?id wdt:{instance of} wd:{dynamic model}. BIND("True" AS ?is_dynamic_raw) }}

    BIND(COALESCE(?is_dynamic_raw, "False") AS ?is_dynamic)

    OPTIONAL {{ ?id wdt:{instance of} wd:{static model}. BIND("True" AS ?is_static_raw) }}

    BIND(COALESCE(?is_static_raw, "False") AS ?is_static)
}}
GROUP BY ?id ?is_linear ?is_not_linear ?is_dynamic ?is_static
