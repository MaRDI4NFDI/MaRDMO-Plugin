# Part 1 of 9 of the MaRDI query formulation-basics_mardi.sparql (see README.md).
# This part decides which items exist; the others add their columns to its rows.
SELECT
?id
(CONCAT("mardi:", STRAFTER(STR(?id), STR(wd:))) AS ?qid)
?reference

WHERE {{

    VALUES ?id {{{0}}}

    OPTIONAL {{
        ?id wdt:{comment} ?reference
    }}
}}
GROUP BY ?id ?reference
