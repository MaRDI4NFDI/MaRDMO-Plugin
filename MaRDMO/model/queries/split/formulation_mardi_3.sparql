# Part 3 of 10 of the MaRDI query formulation_mardi.sparql (see README.md).
SELECT
?id
?is_linear
?is_not_linear
?is_stochastic_differential_equation
?is_integro_differential_equation

WHERE {{

    VALUES ?id {{{0}}}

    OPTIONAL {{ ?id wdt:{instance of} wd:{stochastic differential equation}. BIND("True" AS ?is_stochastic_differential_equation_raw) }}

    BIND(COALESCE(?is_stochastic_differential_equation_raw, "False") AS ?is_stochastic_differential_equation)

    OPTIONAL {{ ?id wdt:{instance of} wd:{integro-differential equation}. BIND("True" AS ?is_integro_differential_equation_raw) }}

    BIND(COALESCE(?is_integro_differential_equation_raw, "False") AS ?is_integro_differential_equation)

    OPTIONAL {{ ?id wdt:{instance of} wd:{linear equation}. BIND("True" AS ?is_linear_raw) }}

    BIND(COALESCE(?is_linear_raw, "False") AS ?is_linear)

    OPTIONAL {{ ?id wdt:{instance of} wd:{nonlinear equation}. BIND("True" AS ?is_not_linear_raw) }}

    BIND(COALESCE(?is_not_linear_raw, "False") AS ?is_not_linear)
}}
GROUP BY ?id ?is_linear ?is_not_linear ?is_stochastic_differential_equation ?is_integro_differential_equation
