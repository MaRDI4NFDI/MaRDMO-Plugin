msgid "must not start with 0 (e.g. 7.5 instead of 07.5)"
msgstr "darf nicht mit 0 beginnen (z. B. 7.5 statt 07.5)"

#: MaRDMO/components/validators.py:539
msgid "must be a number (e.g. 12 or 1.5)"
msgstr "muss eine Zahl sein (z. B. 12 oder 1.5)"

#: MaRDMO/components/validators.py:541
msgid "must be greater than 0"
msgstr "muss größer als 0 sein"

#: MaRDMO/components/validators.py:557
msgid "Enter a whole number of at least 1 without leading zeros (e.g. 4)."
msgstr "Geben Sie eine ganze Zahl von mindestens 1 ohne führende Nullen ein (z. B. 4)."

#: MaRDMO/components/validators.py:579
msgid "Enter the number of items as a whole number of at least 1 (e.g. 250)."
msgstr "Geben Sie die Anzahl der Einträge als ganze Zahl von mindestens 1 ein (z. B. 250)."

#: MaRDMO/components/validators.py:583
msgid "Use a dot as decimal separator (e.g. 1.5)."
msgstr "Verwenden Sie einen Punkt als Dezimaltrennzeichen (z. B. 1.5)."

#: MaRDMO/components/validators.py:585
msgid "Enter the size as a number (e.g. 12 or 1.5)."
msgstr "Geben Sie die Größe als Zahl ein (z. B. 12 oder 1.5)."

#: MaRDMO/components/validators.py:606
msgid "Archival year must be a 4-digit year (e.g. 2030)."
msgstr "Das Archivierungsjahr muss eine vierstellige Jahreszahl sein (z. B. 2030)."

