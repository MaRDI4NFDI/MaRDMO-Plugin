#: MaRDMO/components/validators.py:116
msgid "URL must start with http:// or https://"
msgstr "Die URL muss mit http:// oder https:// beginnen"

#: MaRDMO/components/validators.py:117
msgid "URL must start with http://, https://, git://, ssh://, svn://, cvs://, bzr:// or ftp://"
msgstr "Die URL muss mit http://, https://, git://, ssh://, svn://, cvs://, bzr:// oder ftp:// beginnen"

#: MaRDMO/components/validators.py:123
msgid "URL must not be longer than {length} characters"
msgstr "Die URL darf nicht länger als {length} Zeichen sein"

#: MaRDMO/components/validators.py:125
msgid "URL must not contain spaces"
msgstr "Die URL darf keine Leerzeichen enthalten"

#: MaRDMO/components/validators.py:127
msgid "URL contains characters that are not allowed (< > \" { } | \\ ^ `)"
msgstr "Die URL enthält Zeichen, die nicht erlaubt sind (< > \" { } | \\ ^ `)"

#: MaRDMO/components/validators.py:156
msgid "URL contains an invalid port"
msgstr "Die URL enthält einen ungültigen Port"

#: MaRDMO/components/validators.py:161
msgid "URL needs a domain such as example.org"
msgstr "Die URL braucht eine Domain wie example.org"

#: MaRDMO/components/validators.py:205
msgid "Enter only the DOI (e.g. 10.1000/xyz123), not the link"
msgstr "Geben Sie nur die DOI ein (z. B. 10.1000/xyz123), nicht den Link"

#: MaRDMO/components/validators.py:207 MaRDMO/components/validators.py:455
msgid "DOI must have the form 10.XXXX/suffix (e.g. 10.1000/xyz123)"
msgstr "Die DOI muss die Form 10.XXXX/Suffix haben (z. B. 10.1000/xyz123)"

#: MaRDMO/components/validators.py:222
msgid "Enter only the swMATH number (e.g. 7554), not the link"
msgstr "Geben Sie nur die swMATH-Nummer ein (z. B. 7554), nicht den Link"

#: MaRDMO/components/validators.py:224
msgid "swMATH ID must be a number (e.g. 7554)"
msgstr "Die swMATH-ID muss eine Zahl sein (z. B. 7554)"

#: MaRDMO/components/validators.py:238
msgid "Archival year must be a 4-digit year (e.g. 2030)"
msgstr "Das Archivierungsjahr muss eine vierstellige Jahreszahl sein (z. B. 2030)"

#: MaRDMO/components/validators.py:261
msgid "stands for several quantities (in MaRDMO a symbol stands for exactly one quantity; properties belong to the quantity)"
msgstr "steht für mehrere Quantitäten (in MaRDMO steht ein Symbol für genau eine Quantität; Eigenschaften gehören zur Quantität)"

#: MaRDMO/components/validators.py:263
msgid "appears twice with the same quantity"
msgstr "kommt zweimal mit derselben Quantität vor"

#: MaRDMO/components/validators.py:329
msgid "contains a % comment, which would hide the rest of the formula (use \\% for a percent sign)"
msgstr "enthält einen %-Kommentar, der den Rest der Formel verbergen würde (verwenden Sie \\% für ein Prozentzeichen)"

#: MaRDMO/components/validators.py:349
msgid "Line breaks are not allowed here: the MaRDI Portal stores this answer as single-line text."
msgstr "Zeilenumbrüche sind hier nicht erlaubt: Das MaRDI Portal speichert diese Antwort als einzeiligen Text."

#: MaRDMO/components/validators.py:368
msgid "Short description must not exceed {max_length} characters."
msgstr "Die Kurzbeschreibung darf höchstens {max_length} Zeichen lang sein."

#: MaRDMO/components/validators.py:399
msgid "Invalid QUDT ID. Must start with an uppercase letter and contain only letters, underscores, or hyphens (e.g. SpeedOfLight)."
msgstr "Ungültige QUDT-ID. Sie muss mit einem Großbuchstaben beginnen und darf nur Buchstaben, Unterstriche oder Bindestriche enthalten (z. B. SpeedOfLight)."

#: MaRDMO/components/validators.py:432
msgid "Enter only the DOI (e.g. 10.1000/xyz123), not the link."
msgstr "Geben Sie nur die DOI ein (z. B. 10.1000/xyz123), nicht den Link."

#: MaRDMO/components/validators.py:436
msgid "Invalid DOI. Expected format: 10.XXXX/suffix (e.g. 10.1000/xyz123)."
msgstr "Ungültige DOI. Erwartetes Format: 10.XXXX/Suffix (z. B. 10.1000/xyz123)."

#: MaRDMO/components/validators.py:457
msgid "Invalid DOI: {problem}"
msgstr "Ungültige DOI: {problem}"

#: MaRDMO/components/validators.py:514
msgid "must be a whole number (e.g. 4)"
msgstr "muss eine ganze Zahl sein (z. B. 4)"

#: MaRDMO/components/validators.py:516
msgid "must be at least 1"
msgstr "muss mindestens 1 sein"

#: MaRDMO/components/validators.py:518
msgid "must not start with 0 (e.g. 8 instead of 08)"
msgstr "darf nicht mit 0 beginnen (z. B. 8 statt 08)"

#: MaRDMO/components/validators.py:535
msgid "use a dot as decimal separator (e.g. 1.5)"
msgstr "verwenden Sie einen Punkt als Dezimaltrennzeichen (z. B. 1.5)"

